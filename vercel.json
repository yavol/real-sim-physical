{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "functions": { "api/handler.js": { "maxDuration": 60 } },
  "rewrites": [
    { "source": "/robot", "destination": "/robot.html" },
    { "source": "/collect", "destination": "/collect.html" },
    { "source": "/api/:route*", "destination": "/api/handler?route=:route*" },
    { "source": "/recordings/:file*", "destination": "/api/handler?recording=:file*" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "same-origin" },
      { "key": "Permissions-Policy", "value": "camera=(self), microphone=(self), geolocation=()" },
      { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
    ] },
    { "source": "/api/(.*)", "headers": [{ "key": "Cache-Control", "value": "private, no-store" }] }
  ]
}
